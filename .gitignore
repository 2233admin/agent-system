__pycache__/
*.pyc
build/
.venv/
dist/
*.egg-info/
node_modules/
*.py[cod]
.cap-rendered/
*.receipt.json
*.state/
*.clean-home/
*.agent-homes/
*.runs/
*.log
.DS_Store
WATCHDOG.yml

# OpenSpec CLI-generated client projections; canonical contracts live in .cap.
.agents/skills/.openspec-target
.agents/skills/openspec-*/
.claude/skills/openspec-*/
.claude/commands/opsx/
.omp/commands/opsx-*.md
.omp/skills/openspec-*/
.qoder/commands/opsx/
.qoder/skills/openspec-*/

# _bmad/, .claude/skills/, and .agents/skills/ (the BMad installation and
# its skill content) were previously local-only via .git/info/exclude --
# 2026-08-23: tracked instead, so every clone/session gets the same skills
# without a separate local install step. *.user.toml anywhere under _bmad/
# (installer-managed, personal-scoped: _bmad/config.user.toml itself, and
# team-override companions like _bmad/custom/*.user.toml) stays untracked.
_bmad/**/*.user.toml

# Claude Code / agent runtime-local session state -- never shared, unlike
# the skill content above.
.claude/settings.local.json
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
