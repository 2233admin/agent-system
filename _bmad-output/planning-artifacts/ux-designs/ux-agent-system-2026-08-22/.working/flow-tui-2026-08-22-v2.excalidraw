"height": 162.5,
"strokeColor": "#1e1e1e",
"backgroundColor": "transparent",
"fillStyle": "solid",
"text": "omp exits → configs prints final\nstatus as plain text\n(same renderLaunchStatus the\nexisting CLI already uses:\nphase / apply-result /\nknown-differences)\n\n→ configs process exits entirely,\ncontrol returns to the user's\nreal shell prompt",
"fontSize": 13,
"fontFamily": 1,
"textAlign": "left",
"verticalAlign": "top",
"baseline": 13,
"containerId": null,
"originalText": "omp exits → configs prints final\nstatus as plain text\n(same renderLaunchStatus the\nexisting CLI already uses:\nphase / apply-result /\nknown-differences)\n\n→ configs process exits entirely,\ncontrol returns to the user's\nreal shell prompt",
"lineHeight": 1.25,
"index": "bH"
},
